{
  "name": "tabula-latina",
  "version": "0.1.0",
  "private": true,
  "description": "Latin trainer for the Easy Latin Lessons playlist, published as a claude.ai artifact.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
